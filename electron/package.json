{
  "author": "Ant",
  "build": {
    "appId": "com.ant.puppy-omega-one",
    "directories": {
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "../assets",
        "to": "assets"
      }
    ],
    "icon": "../assets/icon",
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "productName": "Puppy Omega One",
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "description": "Chat-first coding agent workspace with an integrated Omega orchestration mode; installed Puppy GUI transport pending native session verification.",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "tsx": "^4.19.2"
  },
  "main": "out/main/index.js",
  "name": "puppy-omega-one",
  "private": true,
  "scripts": {
    "build": "electron-vite build && npm run verify:build",
    "typecheck": "tsc --noEmit",
    "dev": "electron-vite dev",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "preview": "electron-vite preview",
    "test": "tsx --test src/shared/workflow-events.test.ts src/main/services/project-safety.test.ts src/main/services/draft-validation.test.ts src/shared/event-log.test.ts src/renderer/src/pages/AgentWorkspacePage.test.tsx src/main/services/code-puppy-acp.test.ts && node --test scripts/verify-build.test.mjs ",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "type": "module",
  "version": "0.1.0"
}
